# ── Network ─────────────────────────────────────────────
# Use a paid RPC (Helius, Triton, QuickNode). getProgramAccounts is needed for holder snapshots.
RPC_URL=https://api.mainnet-beta.solana.com

# ── Keeper wallet (creator wallet of PFX, receives the creator fees) ──
# Base58 secret or a JSON byte array. Or point KEEPER_KEYPAIR_PATH at a keypair file.
KEEPER_SECRET_KEY=
KEEPER_KEYPAIR_PATH=

# The PFX token mint (set once it's launched on pump.fun)
PFX_MINT=

# Keep true until you've watched a few dry epochs. Dry runs never sign anything.
DRY_RUN=true
DRY_RUN_BUDGET_SOL=1

# ── Epochs ──────────────────────────────────────────────
EPOCH_MINUTES=45
SNAPSHOT_MINUTES=5
# Epoch boundaries are aligned to this timestamp (ms). Dashboard uses the same value.
EPOCH_GENESIS_MS=1767225600000

# ── Index ───────────────────────────────────────────────
INDEX_SIZE=5
INDEX_WEIGHTING=equal        # equal | mcap
INDEX_MAX_WEIGHT=0.4         # cap per coin when mcap-weighted
CANDIDATE_POOL=100
INDEX_BLACKLIST=             # comma-separated mints never to buy

# ── Outlier screen (coins) ──────────────────────────────
FILTER_MIN_AGE_HOURS=72
FILTER_MIN_LIQUIDITY_USD=250000
FILTER_MIN_VOLUME_USD=50000
FILTER_MIN_SELLS=200
FILTER_MAX_BUY_SELL_RATIO=4
FILTER_MAX_MCAP_TO_LIQ=60
FILTER_MAD_Z=3.5

# ── Holders ─────────────────────────────────────────────
HOLDER_MIN_BALANCE=10000     # whole PFX
HOLDER_MAX_WALLET_PCT=3      # whale cap, % of the drop
HOLDER_IQR_K=3
HOLDER_SELL_TOLERANCE=0.0001
HOLDER_EXCLUDE=              # comma-separated wallets (dev, team, CEX) never paid

# ── Execution ───────────────────────────────────────────
SOL_RESERVE=0.25             # SOL kept for gas + token-account rent
BUY_SHARE=0.9                # share of spendable SOL used per epoch
SLIPPAGE_BPS=300
PRIORITY_MICROLAMPORTS=50000
MIN_ALLOCATION_USD=0.25      # smaller shares roll over to next epoch
AIRDROP_BATCH=5
CLAIM_FEES=true
CREATOR_FEE_POOL=pump
JUP_API_BASE=https://lite-api.jup.ag
JUP_API_KEY=

# Where the dashboard reads from
PUBLISH_DIR=../web/data
